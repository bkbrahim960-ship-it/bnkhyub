{
  "rewrites": [
    { "source": "/api/koralive", "destination": "/api/koralive" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-src *; child-src 'self'; navigate-to 'self';"
        }
      ]
    }
  ]
}
